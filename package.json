{
  "name": "@nkavt/medusa-plugin-telegram",
  "version": "0.1.0",
  "description": "Telegram notifications for Medusa v2: new customers, orders, fulfillments and returns sent to a Telegram chat. Choose events, message language and whether customer contact details are included from the admin.",
  "author": "Nikoloz Kavtaradze",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkavt/medusa-plugin-telegram.git"
  },
  "homepage": "https://github.com/nkavt/medusa-plugin-telegram#readme",
  "bugs": {
    "url": "https://github.com/nkavt/medusa-plugin-telegram/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin",
    "medusa-v2",
    "medusa-plugin-notification",
    "telegram"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "typecheck": "npm run typecheck:admin && npm run typecheck:tests",
    "typecheck:admin": "tsc -p src/admin --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "prepublishOnly": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/eslint-plugin": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/icons": "2.19.0",
    "@medusajs/js-sdk": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/test-utils": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jiti": "^2.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.19.0",
    "@medusajs/cli": "^2.19.0",
    "@medusajs/framework": "^2.19.0",
    "@medusajs/icons": "^2.19.0",
    "@medusajs/js-sdk": "^2.19.0",
    "@medusajs/medusa": "^2.19.0",
    "@medusajs/test-utils": "^2.19.0",
    "@medusajs/ui": "^4.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.8.0"
}
